PORT=5001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Production hardening
# Must be set to a strong random secret in real deployments.
DOC_RETRIEVAL_ENCRYPTION_KEY=change_this_to_a_secure_random_key
ALLOW_DEMO_DRIVE=false

# Google OAuth2 Configuration (for multi-account Google Drive)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Configurable Local Filesystem Search Root (comma-separated, supports ~)
# Falls back to sample-docs, ~/Documents, ~/Downloads, ~/Desktop
DOCS_SEARCH_PATH=./sample-docs,~/Documents,~/Downloads
